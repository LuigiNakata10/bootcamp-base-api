      "maxLength": 1000,
      "pattern": "^[^\\u0000]*$"
    },
    "cnpj": {
      "type": "string",
      "minLength": 14,
      "maxLength": 14,
      "pattern": "^[A-Za-z0-9]{12}[0-9]{2}$"
    }
  },
  "required": [
